# ==============================================================================
# EEC Resource Management System (RMS) - Backend Environment Template
# ==============================================================================
# Copy this file to .env to configure your local or production backend instance.

# HTTP Server Port
PORT=5000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# PostgreSQL Database Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eec_rms_db?schema=public"

# Trusted Frontend Origin for CORS & Session Cookie Security
# In local development: http://localhost:5173
# In production: https://rms.eec.gov.et
FRONTEND_URL="http://localhost:5173"

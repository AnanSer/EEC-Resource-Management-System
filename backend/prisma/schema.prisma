// Ethiopian Engineering Corporation (EEC)
// Resource Management System (RMS)
// Prisma Schema - Phase 3: Resource Registry

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Baseline System Health
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("HEALTHY")
  createdAt DateTime @default(now())
}

// Corporate Directorate / Department Model
model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  description String?
  managerName String?
  location    String?
  budgetCode  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       User[]
  employees   Employee[]
  resources   Resource[]

  @@map("departments")
}

// Baseline Custom Auth: User Model
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         String      @default("EMPLOYEE")
  status       String      @default("PENDING")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employee     Employee?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]

  @@map("users")
}

// Personnel / Employee Model
model Employee {
  id                String     @id @default(uuid())
  employeeId        String     @unique
  name              String
  email             String     @unique
  phone             String?
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation       String
  role              String     @default("EMPLOYEE")
  isActive          Boolean    @default(true)
  hireDate          DateTime   @default(now())
  userId            String?    @unique
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedResources Resource[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("employees")
}

// Baseline Custom Auth: Session Model (HTTP-only session cookies)
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// Individually Tracked Corporate Resource / Physical Asset
model Resource {
  id                  String     @id @default(uuid())
  itemCode            String     @unique
  name                String
  category            String
  subcategory         String?
  description         String?
  manufacturer        String?
  model               String?
  serialNumber        String?
  status              String     @default("AVAILABLE")
  condition           String     @default("GOOD")
  location            String     @default("Central Store - Kersa")
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  currentAssigneeId   String?
  currentAssignee     Employee?  @relation(fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?
  purchaseDate        DateTime?
  purchaseCostETB     Float?
  currentValueETB     Float?
  warrantyExpiry      DateTime?
  supplier            String?
  notes               String?
  specs               Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([departmentId])
  @@index([category])
  @@index([status])
  @@index([itemCode])
  @@map("resources")
}

// Ethiopian Engineering Corporation (EEC)
// Resource Management System (RMS)
// Prisma Schema - Phase 3: Resource Registry

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Baseline System Health
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("HEALTHY")
  createdAt DateTime @default(now())
}

// Corporate Directorate / Department Model
model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  description String?
  managerName String?
  location    String?
  budgetCode  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       User[]
  employees   Employee[]
  resources   Resource[]
  assignments ResourceAssignment[]
  transfersFrom CustodyTransfer[] @relation("TransfersFromDept")
  transfersTo   CustodyTransfer[] @relation("TransfersToDept")

  @@map("departments")
}

// Baseline Custom Auth: User Model
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         String      @default("EMPLOYEE")
  status       String      @default("PENDING")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employee     Employee?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]

  @@map("users")
}

// Personnel / Employee Model
model Employee {
  id                String     @id @default(uuid())
  employeeId        String     @unique
  name              String
  email             String     @unique
  phone             String?
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation       String
  role              String     @default("EMPLOYEE")
  isActive          Boolean    @default(true)
  hireDate          DateTime   @default(now())
  userId            String?    @unique
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedResources Resource[]
  assignments       ResourceAssignment[]
  transfersFrom     CustodyTransfer[] @relation("TransfersFrom")
  transfersTo       CustodyTransfer[] @relation("TransfersTo")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("employees")
}

// Baseline Custom Auth: Session Model (HTTP-only session cookies)
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// Individually Tracked Corporate Resource / Physical Asset
model Resource {
  id                  String     @id @default(uuid())
  itemCode            String     @unique
  name                String
  category            String
  subcategory         String?
  description         String?
  manufacturer        String?
  model               String?
  serialNumber        String?
  status              String     @default("AVAILABLE")
  condition           String     @default("GOOD")
  location            String     @default("Central Store - Kersa")
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  currentAssigneeId   String?
  currentAssignee     Employee?  @relation(fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?
  purchaseDate        DateTime?
  purchaseCostETB     Float?
  currentValueETB     Float?
  warrantyExpiry      DateTime?
  supplier            String?
  notes               String?
  specs               Json?
  assignments         ResourceAssignment[]
  transfers           CustodyTransfer[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([departmentId])
  @@index([category])
  @@index([status])
  @@index([itemCode])
  @@map("resources")
}

// Resource Assignment Model (Active and Historical Assignments)
model ResourceAssignment {
  id                    String            @id @default(uuid())
  assignmentNumber      String            @unique
  resourceId            String
  resource              Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  employeeId            String
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  departmentId          String
  department            Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedByName        String
  assignedById          String?
  assignedAt            DateTime          @default(now())
  expectedReturnDate    DateTime?
  purpose               String
  notes                 String?
  status                String            @default("ACTIVE") // ACTIVE, TRANSFERRED, RETURNED
  isCurrent             Boolean           @default(true)
  
  // Return fields
  returnedAt            DateTime?
  returnCondition       String?
  returnLocation        String?
  returnNotes           String?
  returnReceivedByName  String?
  returnReceivedById    String?
  
  transfersOut          CustodyTransfer[] @relation("TransferFromAssignment")
  transfersIn           CustodyTransfer[] @relation("TransferToAssignment")
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([resourceId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([status])
  @@index([isCurrent])
  @@map("resource_assignments")
}

// Custody Transfer History Model
model CustodyTransfer {
  id                  String              @id @default(uuid())
  transferNumber      String              @unique
  resourceId          String
  resource            Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  fromAssignmentId    String?
  fromAssignment      ResourceAssignment? @relation("TransferFromAssignment", fields: [fromAssignmentId], references: [id], onDelete: SetNull)
  toAssignmentId      String?
  toAssignment        ResourceAssignment? @relation("TransferToAssignment", fields: [toAssignmentId], references: [id], onDelete: SetNull)
  fromEmployeeId      String
  fromEmployee        Employee            @relation("TransfersFrom", fields: [fromEmployeeId], references: [id], onDelete: Restrict)
  toEmployeeId        String
  toEmployee          Employee            @relation("TransfersTo", fields: [toEmployeeId], references: [id], onDelete: Restrict)
  fromDepartmentId    String
  fromDepartment      Department          @relation("TransfersFromDept", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartmentId      String
  toDepartment        Department          @relation("TransfersToDept", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  transferredByName   String
  transferredById     String?
  reason              String?
  notes               String?
  transferredAt       DateTime            @default(now())
  createdAt           DateTime            @default(now())

  @@index([resourceId])
  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@map("custody_transfers")
}

// Ethiopian Engineering Corporation (EEC)
// Resource Management System (RMS)
// Prisma Schema - Phase 3: Resource Registry

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Baseline System Health
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("HEALTHY")
  createdAt DateTime @default(now())
}

// Corporate Directorate / Department Model
model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  description String?
  managerName String?
  location    String?
  budgetCode  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       User[]
  employees   Employee[]
  resources   Resource[]
  assignments ResourceAssignment[]
  transfersFrom CustodyTransfer[] @relation("TransfersFromDept")
  transfersTo   CustodyTransfer[] @relation("TransfersToDept")
  requisitions  ResourceRequisition[]
  maintenanceRequests MaintenanceRequest[]
  auditEvents AuditEvent[]

  @@map("departments")
}

// Baseline Custom Auth: User Model
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         String      @default("EMPLOYEE")
  status       String      @default("PENDING")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employee     Employee?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]

  @@map("users")
}

// Personnel / Employee Model
model Employee {
  id                String     @id @default(uuid())
  employeeId        String     @unique
  name              String
  email             String     @unique
  phone             String?
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation       String
  role              String     @default("EMPLOYEE")
  isActive          Boolean    @default(true)
  hireDate          DateTime   @default(now())
  userId            String?    @unique
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedResources Resource[]
  assignments       ResourceAssignment[]
  transfersFrom     CustodyTransfer[] @relation("TransfersFrom")
  transfersTo       CustodyTransfer[] @relation("TransfersTo")
  requisitions      ResourceRequisition[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("employees")
}

// Baseline Custom Auth: Session Model (HTTP-only session cookies)
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// Individually Tracked Corporate Resource / Physical Asset
model Resource {
  id                  String     @id @default(uuid())
  itemCode            String     @unique
  name                String
  category            String
  subcategory         String?
  description         String?
  manufacturer        String?
  model               String?
  serialNumber        String?
  status              String     @default("AVAILABLE")
  condition           String     @default("GOOD")
  location            String     @default("Central Store - Kersa")
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  currentAssigneeId   String?
  currentAssignee     Employee?  @relation(fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?
  purchaseDate        DateTime?
  purchaseCostETB     Float?
  currentValueETB     Float?
  warrantyExpiry      DateTime?
  supplier            String?
  notes               String?
  specs               Json?
  assignments         ResourceAssignment[]
  transfers           CustodyTransfer[]
  requisitions        ResourceRequisition[]
  maintenanceRequests MaintenanceRequest[]
  maintenanceInspections MaintenanceInspection[]
  auditEvents         AuditEvent[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([departmentId])
  @@index([category])
  @@index([status])
  @@index([itemCode])
  @@map("resources")
}

// Resource Assignment Model (Active and Historical Assignments)
model ResourceAssignment {
  id                    String            @id @default(uuid())
  assignmentNumber      String            @unique
  resourceId            String
  resource              Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  employeeId            String
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  departmentId          String
  department            Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedByName        String
  assignedById          String?
  assignedAt            DateTime          @default(now())
  expectedReturnDate    DateTime?
  purpose               String
  notes                 String?
  status                String            @default("ACTIVE") // ACTIVE, TRANSFERRED, RETURNED
  isCurrent             Boolean           @default(true)
  
  // Return fields
  returnedAt            DateTime?
  returnCondition       String?
  returnLocation        String?
  returnNotes           String?
  returnReceivedByName  String?
  returnReceivedById    String?
  
  transfersOut          CustodyTransfer[] @relation("TransferFromAssignment")
  transfersIn           CustodyTransfer[] @relation("TransferToAssignment")
  requisition           ResourceRequisition?
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([resourceId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([status])
  @@index([isCurrent])
  @@map("resource_assignments")
}

// Custody Transfer History Model
model CustodyTransfer {
  id                  String              @id @default(uuid())
  transferNumber      String              @unique
  resourceId          String
  resource            Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  fromAssignmentId    String?
  fromAssignment      ResourceAssignment? @relation("TransferFromAssignment", fields: [fromAssignmentId], references: [id], onDelete: SetNull)
  toAssignmentId      String?
  toAssignment        ResourceAssignment? @relation("TransferToAssignment", fields: [toAssignmentId], references: [id], onDelete: SetNull)
  fromEmployeeId      String
  fromEmployee        Employee            @relation("TransfersFrom", fields: [fromEmployeeId], references: [id], onDelete: Restrict)
  toEmployeeId        String
  toEmployee          Employee            @relation("TransfersTo", fields: [toEmployeeId], references: [id], onDelete: Restrict)
  fromDepartmentId    String
  fromDepartment      Department          @relation("TransfersFromDept", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartmentId      String
  toDepartment        Department          @relation("TransfersToDept", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  transferredByName   String
  transferredById     String?
  reason              String?
  notes               String?
  transferredAt       DateTime            @default(now())
  createdAt           DateTime            @default(now())

  @@index([resourceId])
  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@map("custody_transfers")
}

// Resource Requisition & Allocation Model
model ResourceRequisition {
  id                    String              @id @default(uuid())
  requisitionNumber     String              @unique
  requesterId           String
  requesterName         String
  requesterRole         String              @default("EMPLOYEE")
  employeeId            String
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  departmentId          String
  department            Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  category              String
  itemDescription       String
  justification         String
  urgency               String              @default("ROUTINE") // ROUTINE, URGENT, EMERGENCY_PROJECT
  status                String              @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED, CANCELLED
  requiredDate          DateTime?
  isDirectAllocation    Boolean             @default(false)
  approvedById          String?
  approvedByName        String?
  approvedAt            DateTime?
  approvalComments      String?
  rejectionReason       String?
  rejectedAt            DateTime?
  fulfilledResourceId   String?
  fulfilledResource     Resource?           @relation(fields: [fulfilledResourceId], references: [id], onDelete: SetNull)
  fulfilledAssignmentId String?             @unique
  fulfilledAssignment   ResourceAssignment? @relation(fields: [fulfilledAssignmentId], references: [id], onDelete: SetNull)
  fulfilledById         String?
  fulfilledByName       String?
  fulfilledAt           DateTime?
  handoverNotes         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([employeeId])
  @@index([departmentId])
  @@index([status])
  @@index([category])
  @@map("resource_requisitions")
}

// Maintenance Management Models
model MaintenanceRequest {
  id                      String                  @id @default(uuid())
  requestNumber           String                  @unique // e.g. MNT-2026-0001
  resourceId              String
  resource                Resource                @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  departmentId            String
  department              Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reportedById            String
  reportedByName          String
  reportedByRole          String                  @default("EMPLOYEE")
  assignedTechnicianId    String?
  assignedTechnicianName  String?
  title                   String
  description             String
  priority                String                  @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status                  String                  @default("SUBMITTED") // SUBMITTED, APPROVED, IN_PROGRESS, ON_HOLD, COMPLETED, REJECTED
  reportedDate            DateTime                @default(now())
  reviewedById            String?
  reviewedByName          String?
  reviewedAt              DateTime?
  reviewComments          String?
  rejectionReason         String?
  startedAt               DateTime?
  completedAt             DateTime?
  diagnosis               String?
  repairActions           String?
  partsReplaced           String?
  estimatedCostETB        Float?
  actualCostETB           Float?
  resolutionNotes         String?
  outcome                 String?                 // REPAIRED_FIT_FOR_USE, BEYOND_ECONOMIC_REPAIR, DISPOSED
  custodyAction           String?                 // RETURNED_TO_CUSTODIAN, RETURNED_TO_AVAILABLE, DECOMMISSIONED
  custodianIdAtRequest    String?                 // Preserved active custodian ID at time of request
  custodianNameAtRequest  String?                 // Preserved active custodian name at time of request

  logs                    MaintenanceLog[]
  inspections             MaintenanceInspection[]

  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([resourceId])
  @@index([departmentId])
  @@index([status])
  @@index([priority])
  @@index([reportedById])
  @@index([assignedTechnicianId])
  @@map("maintenance_requests")
}

model MaintenanceLog {
  id                    String              @id @default(uuid())
  maintenanceRequestId  String
  maintenanceRequest    MaintenanceRequest  @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  fromStatus            String?
  toStatus              String
  action                String              // SUBMITTED, APPROVED, REJECTED, ASSIGNED, STARTED, PUT_ON_HOLD, RESUMED, COMPLETED
  actorId               String
  actorName             String
  actorRole             String
  notes                 String?
  createdAt             DateTime            @default(now())

  @@index([maintenanceRequestId])
  @@map("maintenance_logs")
}

model MaintenanceInspection {
  id                    String              @id @default(uuid())
  maintenanceRequestId  String?
  maintenanceRequest    MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  resourceId            String
  resource              Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  inspectionType        String              @default("MAINTENANCE_QA") // MAINTENANCE_QA, CALIBRATION, ROADWORTHINESS_BOLO, HYDRAULIC, SAFETY_AUDIT
  passed                Boolean
  findings              String
  conductedById         String?
  conductedByName       String
  certificationNumber   String?
  remarks               String?
  inspectedAt           DateTime            @default(now())
  createdAt             DateTime            @default(now())

  @@index([maintenanceRequestId])
  @@index([resourceId])
  @@map("maintenance_inspections")
}

// Centralized Audit Event Model for Resource Lifecycle & Operational Governance
model AuditEvent {
  id                String      @id @default(uuid())
  actionType        String      // RESOURCE_REGISTERED, RESOURCE_UPDATED, CONDITION_CHANGED, STATUS_CHANGED, ASSIGNED, TRANSFERRED, RETURNED, MAINTENANCE_SUBMITTED, MAINTENANCE_APPROVED, MAINTENANCE_REJECTED, MAINTENANCE_PROGRESS, MAINTENANCE_ON_HOLD, MAINTENANCE_RESUMED, MAINTENANCE_COMPLETED, INSPECTION_RECORDED, RETIRED, DISPOSED
  resourceId        String?
  resource          Resource?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  resourceName      String?
  resourceCode      String?
  resourceCategory  String?
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  actorId           String?
  actorName         String
  actorRole         String
  referenceId       String?     // itemCode, assignmentNumber, transferNumber, requestNumber, etc.
  details           String?     // Human-readable summary of the action and parameters
  metadata          Json?       // Structured metadata / change details
  timestamp         DateTime    @default(now())
  createdAt         DateTime    @default(now())

  @@index([resourceId])
  @@index([departmentId])
  @@index([actorId])
  @@index([actionType])
  @@index([timestamp])
  @@index([referenceId])
  @@map("audit_events")
}

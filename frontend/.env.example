# ==============================================================================
# EEC Resource Management System (RMS) - Frontend Environment Template
# ==============================================================================
# Copy this file to .env or .env.local to configure your active local or production API URL.

# Base URL pointing to the Express Backend API (defaults to local port 5000 in dev)
# For production deployments (e.g. Vercel, Netlify, Cloudflare), set this to your public backend URL:
# e.g. VITE_API_URL="https://api-rms.eec.gov.et/api"
VITE_API_URL="http://localhost:5000/api"
